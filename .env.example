# ==========================================================================
# chlauncher — example environment configuration.
# Copy this file to `.env` (never commit `.env`) and fill in real values.
# ==========================================================================

# ---- Backend server (apps/server) ----

# 'production' enables strict startup checks: the server REFUSES to boot
# without a real JWT_SECRET or with ENABLE_MOCK_BILLING=1.
# NODE_ENV=production

# Port the licensing/API server listens on.
SERVER_PORT=8787

# Secret used to sign JWT auth tokens. REQUIRED in production —
# generate a long random string, e.g. `openssl rand -hex 64`.
JWT_SECRET=dev-only-insecure-secret-change-me

# HMAC key for hashing stored HWIDs/IPs at rest. REQUIRED in production —
# generate `openssl rand -hex 32`. Dev/test derive it from JWT_SECRET.
# Rotating it invalidates every device binding (users must re-login).
# HWID_HASH_SECRET=

# Host the server binds to. Use 0.0.0.0 only when intentionally serving
# the LAN/internet — the launcher-facing services are loopback-only.
# SERVER_HOST=127.0.0.1

# Path to the SQLite database file (relative to apps/server).
DATABASE_PATH=./data/chlauncher.db

# Comma-separated emails that get role='admin' on every register/login.
# DEV ONLY — ignored (with a warning) when NODE_ENV=production.
# In production grant roles via: node tools/grant-admin.mjs <email>
# ADMIN_EMAILS=alice@example.com,bob@example.com

# Upload cap for admin game builds (bytes). Default 2 GiB.
# MAX_BUILD_SIZE=2147483648

# Comma-separated CORS whitelist for browser clients. In dev the local
# Vite/Tauri origins are allowed by default; in production ONLY the
# origins listed here get CORS headers.
# CORS_ORIGINS=https://launcher.example.com,https://admin.example.com

# Trust X-Forwarded-For / CF-Connecting-IP for client IPs.
# Enable ONLY when the server sits behind a reverse proxy or Cloudflare —
# otherwise clients can spoof their IP for rate-limit/HWID checks.
# TRUST_PROXY=true

# Enables mock-pay / mock-expire test endpoints. Enabled automatically
# outside production; setting =1 together with NODE_ENV=production makes
# the server refuse to start.
# ENABLE_MOCK_BILLING=1

# ---- Payments (production webhooks) ----
# Stripe webhook signing secret — verify `Stripe-Signature` header.
# STRIPE_WEBHOOK_SECRET=whsec_...
# YooKassa shop id / secret for payment confirmation callbacks.
# YOOKASSA_SHOP_ID=
# YOOKASSA_SECRET_KEY=

# ---- Tribute (Telegram) provider ----
# API key from Tribute Creator Dashboard → Settings → API Keys. Signs
# webhooks (`trbt-signature` = HMAC-SHA256 of the raw body). Point the
# dashboard's webhook URL at https://api.<domain>/api/billing/tribute/webhook.
# TRIBUTE_API_KEY=
# Deep-link base of OUR bind-bot (apps/launcher/tg-bot): a one-shot code is
# appended to it, e.g. https://t.me/<botname>?start=
# TRIBUTE_BOT_URL=https://t.me/chlauncher_bind_bot?start=
# Shared secret the bind-bot presents on POST /api/tg/bind (header
# x-bot-secret). Generate with `openssl rand -hex 32`.
# TG_BIND_SECRET=
# JSON map: our plan_code → Tribute payment link shown after binding.
# TRIBUTE_PRODUCT_LINKS={"pro":"https://t.me/tribute?startapp=abc","expert":"https://t.me/tribute?startapp=xyz"}
# JSON map: Tribute subscription_id → our plan_code (webhook → plan).
# TRIBUTE_PLAN_MAP={"1644":"pro","1645":"expert"}
#
# apps/launcher/tg-bot/.env additionally needs:
#   TG_BOT_TOKEN=<BotFather token>  TG_BIND_SECRET=<same as above>
#   SERVER_URL=http://127.0.0.1:8787

# ---- Launcher runtime (read by the Tauri app / integrations) ----

# Base URL of the licensing backend the launcher talks to.
VITE_API_URL=http://127.0.0.1:8787

# DonationAlerts: token/OAuth credentials for realtime donations.
# Obtain via https://www.donationalerts.com -> API/OAuth app.
# DONATIONALERTS_CLIENT_ID=
# DONATIONALERTS_CLIENT_SECRET=
# Access token pasted by the streamer in the Integrations UI is stored
# in the launcher's own settings store, not in this file.

# TikTok Live signing — TWO modes, pick one per deployment.
#
# A) Server-side paid key (RECOMMENDED for production): set the key on the
#    SERVER only. Launchers route all signing through
#    `POST /api/tiktok-sign/*` — the backend injects this key upstream,
#    it never ships inside the client. Auth + active subscription
#    required; 120 req/min per user (TIKTOK_SIGN_MAX_PER_MIN).
# EULERSTREAM_API_KEY=
# EULERSTREAM_BASE_URL=https://api.eulerstream.com   # upstream override (tests)
# TIKTOK_SIGN_MAX_PER_MIN=120
#
# B) Client-side free tier / personal key: leave EULERSTREAM_API_KEY
#    empty on the server — /api/tiktok-sign/ping reports enabled:false and
#    sidecars fall back to calling EulerStream directly (free rate-limited
#    tier). A personal key can still live in the launcher env var or the
#    file `%APPDATA%/com.chlauncher.app/eulerstream.key` — never in git.

# ---- TikTok Login Kit OAuth (account binding) ----
# Public https origin of THIS api — used to derive the OAuth redirect URI
# and shown in docs. Must match what nginx exposes.
# PUBLIC_BASE_URL=https://api.example.com
#
# Credentials from developers.tiktok.com → your app → Login Kit.
# The app must have scope `user.info.profile` approved (gives the
# @username — without it the bind can't fill the room field).
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
# Must match the URI registered in the TikTok app EXACTLY (https only).
# Defaults to ${PUBLIC_BASE_URL}/api/tiktok/oauth/callback when empty.
# TIKTOK_REDIRECT_URI=https://api.example.com/api/tiktok/oauth/callback
#
# Without client_key the OAuth endpoints answer 501 and the launcher UI
# falls back to the bio/comment code flow.
