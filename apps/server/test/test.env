# Test environment — loaded via `node --env-file=test/test.env` in the
# `npm test` script. Takes precedence over apps/server/.env because
# process.loadEnvFile() never overwrites already-set variables.
#
# Tests exercise mock-pay/mock-expire and subscription gating, so mocks
# must be on regardless of what NODE_ENV the local .env uses for deploy.
NODE_ENV=test
ENABLE_MOCK_BILLING=1
