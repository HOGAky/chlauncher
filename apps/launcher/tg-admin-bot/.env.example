# chlauncher admin-bot env — copy to .env (gitignored, NEVER committed).
#
# Bot token from @BotFather for the PRIVATE admin bot (a different bot
# than the public bind-bot). Owner-only: only ADMIN_TG_ID gets answers.
TG_ADMIN_BOT_TOKEN=

# Your Telegram user id — the only account allowed to use commands.
# Ask the bind-bot /whoami or @userinfobot.
ADMIN_TG_ID=1189459943

# Shared secret with the API server — MUST equal the server's
# TG_BIND_SECRET (it guards /api/tg/grant, /admin/* and bind endpoints).
TG_BIND_SECRET=

# API server base URL — loopback when the bot runs on the same VPS.
SERVER_URL=http://127.0.0.1:8787
