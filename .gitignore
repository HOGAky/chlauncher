# ============================================================
# chlauncher .gitignore
# Excludes build artifacts, dependencies, secrets and OS junk.
# ============================================================

# ---- Secrets (NEVER commit real keys) ----
.env
.env.*
!.env.example
*.pem
*.key

# ---- Node ----
node_modules/
tools/tiktok-sidecar/node.exe
tools/tiktok-sidecar/_*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- Rust / Cargo ----
target/
**/*.rs.bk
Cargo.lock.bak

# ---- Tauri ----
apps/launcher/src-tauri/target/
apps/launcher/src-tauri/gen/

# ---- Frontend builds ----
dist/
dist-ssr/
*.local

# ---- Server data ----
apps/server/data/
apps/server/static/games/*.zip
apps/server/static/games/**/*.zip
apps/server/static/plugins/*.jar

# ---- OS / Editor ----
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo
dist-test/

# ---- RVC voice server (��������� ��������� � ������ ������������) ----
tools/rvc-server/venv/
tools/rvc-server/models/
tools/rvc-server/*.log
tools/rvc-server/*-test*.wav
# ����� �������� ����� � ���� � build.rs �������� ��� � �������.
!tools/tiktok-sidecar/dist/
!tools/tiktok-sidecar/dist/**
*.whl

# stray sqlite databases (real db lives in ignored data/)
*.db
*.db-shm
*.db-wal
