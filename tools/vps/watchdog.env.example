# chlauncher watchdog config — copy to watchdog.env (same directory).
# All keys optional; defaults live in chlauncher-watchdog.sh.

#API_URL=http://127.0.0.1:8787
#SERVER_UNIT=chlauncher-server
#BOT_UNIT=chlauncher-tgbot
#ADMIN_BOT_UNIT=chlauncher-tgadmin
#DISK_PCT=85

# Telegram alerts to the owner on restarts/disk pressure.
# TG_ALERT_TOKEN: reuse TG_BOT_TOKEN (alerts come from the same bot).
# TG_ALERT_CHAT_ID: your Telegram user id — ask the bot /whoami.
#TG_ALERT_TOKEN=
#TG_ALERT_CHAT_ID=
