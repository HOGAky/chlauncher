{
  "name": "chlauncher",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo: TikTok Live interactive games launcher, licensing backend, Rust game SDK and mock game.",
  "workspaces": [
    "apps/server",
    "apps/launcher"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace @chlauncher/server",
    "dev:launcher": "npm run tauri:dev --workspace @chlauncher/launcher",
    "test:server": "npm test --workspace @chlauncher/server"
  },
  "engines": {
    "node": ">=20"
  }
}
